  "teamNews": {
    "bruins": [
      {
        "headline": "Bruins visit slumping Blues to close trip",
        "summary": "Boston (9-3-1) plays at St. Louis Thursday at 8 p.m. ET. The Blues have been shut out in consecutive home games for the first time since October 2009, most recently a 2-0 loss to Montreal Tuesday despite 46 shots, and haven't scored in 123:55 of game time. Boston won both meetings last season, 5-2 each time.",
        "source": "NHL.com",
        "url": "https://www.nhl.com/blues/news/preview-blues-vs-bruins-10292026",
        "dateLabel": "Oct 28"
      },
      {
        "headline": "Lohrei: 'Take the positives' into St. Louis",
        "summary": "After the 2-1 loss at Carolina ended Boston's eight-game point streak, Mason Lohrei said: \"You've just got to take the positives, and we'll move on and be ready to win in St. Louis.\" Boston managed a season-low 16 shots and was charged with 15 giveaways. Blues coach Jim Montgomery, Boston's former coach, said none of his team's chances against Carolina would rank among its top 15 from Tuesday's game.",
        "source": "107.5 The Game",
        "url": "https://www.1075thegame.com/2026/10/28/bruins-buzzing-into-blues-trip-despite-losing-to-canes/",
        "dateLabel": "Oct 28"
      },
      {
        "headline": "Pastrnak leads scoring; Lindholm on a three-game point streak",
        "summary": "David Pastrnak leads the Bruins with seven goals and 18 points, and J.J. Peterka has nine points in 13 games since arriving from Utah. Elias Lindholm has a point in three straight games (1 goal, 3 assists), centering the third line with Casey Mittelstadt and James Hagens, and has 17 points in 26 career games against St. Louis.",
        "source": "NHL.com",
        "url": "https://www.nhl.com/blues/news/preview-blues-vs-bruins-10292026",
        "dateLabel": "Oct 28"
      }
    ],
    "celtics": [
      {
        "headline": "Devin Carter rejoins team after mono",
        "summary": "Two-way guard Devin Carter has rejoined the Celtics after mononucleosis kept him out to start the season, per CLNS Media's Bobby Manning, though he remains unavailable and hasn't made his regular-season debut. The AP's preview lists him out (illness) for Friday's NBA Cup game against the Bulls.",
        "source": "Hoops Rumors",
        "url": "https://www.hoopsrumors.com/2026/10/celtics-note-carter-pritchard-tatum-brown.html",
        "dateLabel": "Oct 28"
      },
      {
        "headline": "Broadcasters' digs at Jaylen Brown draw criticism",
        "summary": "NBC Sports Boston's Drew Carter and Brian Scalabrine took several jabs at Jaylen Brown during the Bulls and Nets broadcasts, and 98.5 The Sports Hub's \"Felger & Mazz\" criticized them Wednesday; Tony Massarotti called it \"Mickey Mouse, small market.\" Scalabrine had earlier walked back his claim that Brown demanded a trade, and a Brown representative told ESPN the report was \"10000% a lie.\"",
        "source": "Boston.com",
        "url": "https://www.boston.com/sports/boston-celtics/2026/10/28/felger-mazz-boston-celtics-nba-basketball-drew-carter-brian-scalabrine-jaylen-brown/",
        "dateLabel": "Oct 28"
      },
      {
        "headline": "Bulls up next in NBA Cup group play",
        "summary": "Boston (3-1) hosts Chicago (1-4) Friday at 7:30 in an NBA Cup group-stage game, the teams' second meeting after the Celtics' 134-99 win on Oct. 26. The Bulls list Nic Claxton out (hamstring), with Patrick Williams (groin) and Tobe Awaka (ankle) day to day.",
        "source": "AP (Yahoo Sports)",
        "url": "https://sports.yahoo.com/articles/celtics-bulls-meet-friday-nba-060230305.html",
        "dateLabel": "Oct 29"
      }
    ],
    "patriots": [
      {
        "headline": "Full house at practice; Ben Brown back as limited",
        "summary": "Every member of the active roster practiced Wednesday coming out of the mini bye. A.J. Brown (knee, ankle), Morgan Moses (foot), Ben Brown (knee) and DaQuan Jones (back) were limited; Drake Maye (right shoulder), Carlton Davis III (neck) and Marcus Bryant (ankle, back from IR) were full.",
        "source": "Yahoo Sports (SB Nation)",
        "url": "https://sports.yahoo.com/articles/patriots-vs-dolphins-wednesday-injury-210343712.html",
        "dateLabel": "Oct 28"
      },
      {
        "headline": "Vrabel praises Ollie Gordon II; roster moves",
        "summary": "Mike Vrabel said Ollie Gordon II is \"doing exactly what we talk about and getting opportunities and making the most of them\"; Gordon has four touchdowns in his last four games. The Patriots signed LB Jose Ramirez to the practice squad, released OL Jacob Rizy from it, and released P Bryce Baringer from injured reserve. Vrabel said he wouldn't expect Dell Pettus or Greg Van Roten at practice Wednesday.",
        "source": "Patriots.com",
        "url": "https://www.patriots.com/news/transcript-head-coach-mike-vrabel-press-conference-10-28",
        "dateLabel": "Oct 28"
      },
      {
        "headline": "Henderson could return to kick returns",
        "summary": "Vrabel said the team is weighing whether TreVeyon Henderson goes back to kick return duty, with Corey Kiner and Kyle Williams also options. Of Miami, he said the Dolphins \"play extremely hard\" and singled out Malik Willis's designed runs and scrambles.",
        "source": "Patriots.com",
        "url": "https://www.patriots.com/news/transcript-head-coach-mike-vrabel-press-conference-10-28",
        "dateLabel": "Oct 28"
      }
    ],
    "redsox": [
      {
        "headline": "Red Sox hire Astros' Jason Bell as outfield instructor",
        "summary": "Boston is adding Jason Bell, who spent the past decade with Houston, to its major league staff, including as outfield instructor, per a league source. He was the Astros' field coordinator for two years and quality control coach for one. The Red Sox still have at least two openings under Chad Tracy: first base and third base coach.",
        "source": "Boston Globe",
        "url": "https://www.bostonglobe.com/2026/10/28/sports/jason-bell-red-sox-outfield/",
        "dateLabel": "Oct 28"
      },
      {
        "headline": "Baseball sciences director Besky leaves for Nationals",
        "summary": "David Besky, the Red Sox's director of baseball sciences, is leaving for Washington to be a uniformed pitching strategist, per reports from MassLive's Chris Cotillo and the Baltimore Banner. He's the first offseason hire for ex-Sox assistant GM Paul Toboni, now the Nationals' president of baseball operations.",
        "source": "Yahoo Sports",
        "url": "https://sports.yahoo.com/articles/front-office-brain-drain-continues-041620131.html",
        "dateLabel": "Oct 27"
      },
