    "sections": [
      {
        "label": "1st period",
        "score": "BOS 2, WPG 1",
        "text": "Dylan DeMelo's point shot through a screen put Winnipeg up 1–0 at 4:52. Hampus Lindholm answered with a one-timer from the blue line at 9:23 for 1–1, and at 15:20 James Hagens finished a Nikita Zadorov feed after Mark Kastelic drove the net, his first NHL goal, for a 2–1 lead."
      },
      {
        "label": "2nd period",
        "score": "WPG 3, BOS 2",
        "text": "Kyle Connor tied it 2–2 on a power play at 1:50, extending his NHL-record streak of scoring in season openers to nine games. Mario Ferraro's wrister from the left circle with eight seconds left in the period gave the Jets a 3–2 lead."
      },
      {
        "label": "3rd period",
        "score": "BOS 3, WPG 3",
        "text": "With Jeremy Swayman pulled for an extra attacker, Elias Lindholm tipped in David Pastrnak's shot with 1:38 left in regulation to tie it 3–3."
      },
      {
        "label": "Overtime",
        "score": "Final: BOS 4, WPG 3",
        "text": "Pastrnak sent JJ Peterka in alone, and Peterka beat Stuart Skinner five-hole at 3:21. Swayman finished with 30 saves."
      }
    ],
