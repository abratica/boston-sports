    "sections": [
      {
        "label": "1st period",
        "score": "BOS 3, UTA 0",
        "text": "Casey Mittelstadt opened the scoring from the left dot at 10:06. David Pastrnak's power-play wrister at 14:22 made it 2–0, his first goal as captain and Boston's first power-play goal of the season, and Mason Lohrei carried in from the blue line and scored at 15:51 for 3–0, chasing Sebastian Cossa. Matthew Poitras took a puck to the face in the period."
      },
      {
        "label": "2nd period",
        "score": "BOS 6, UTA 0",
        "text": "Pastrnak one-timed a Morgan Geekie saucer pass past Karel Vejmelka on a power play at 4:40 for 4–0, and Geekie scored on another power play at 7:57 for 5–0. Poitras, back after needing five stitches, made it 6–0 off a Pastrnak pass at 14:08."
      },
      {
        "label": "3rd period",
        "score": "Final: BOS 6, UTA 1",
        "text": "Jack McBain's deflection at 9:48 ended Jeremy Swayman's shutout bid. Utah went 0-for-7 on the power play."
      }
    ],
