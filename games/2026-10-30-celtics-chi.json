      {
        "label": "1st quarter",
        "score": "BOS 44, CHI 25",
        "text": "Boston went up 22–12 on Paul George's dunk off a Josh Giddey turnover and led 33–18 with three minutes left. The 44–25 quarter was the Celtics' best opening period of the season."
      },
      {
        "label": "2nd quarter",
        "score": "BOS 78, CHI 49",
        "text": "Payton Pritchard's 26-footer made it 63–35 with 6:41 left in the half, and Jayson Tatum's finger roll and 3-pointer pushed the lead to 76–44, its peak of 32, with under two minutes to go. Pritchard had 20 points on 7-of-10 shooting at the break."
      },
      {
        "label": "3rd quarter",
        "score": "BOS 99, CHI 74",
        "text": "Chicago hit four 3-pointers by the middle of the quarter to trim the deficit to 86–66, and Boston managed 21 points, its lowest quarter of the night."
      },
      {
        "label": "4th quarter",
        "score": "Final: BOS 125, CHI 111",
        "text": "Tatum's step-back made it 102–80 with 9:38 left; he later picked up his fifth foul and a technical with about five minutes to go. The Bulls won the quarter 37–26 after Boston pulled its starters."
      }
