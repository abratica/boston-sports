    "sections": [
      {
        "label": "1st quarter",
        "score": "NE 7, PIT 0",
        "text": "New England's opening drive reached the Pittsburgh 34 before Nick Herbig stripped Rhamondre Stevenson. After a 19-yard Marcus Jones punt return, TreVeyon Henderson, in for Stevenson, found a crease for a 39-yard touchdown run with 8:22 left."
      },
      {
        "label": "2nd quarter",
        "score": "NE 10, PIT 3",
        "text": "Andy Borregales' 30-yard field goal made it 10–0 early in the quarter, and Chris Boswell's 56-yarder on the final play of the half got Pittsburgh its only points."
      },
      {
        "label": "3rd quarter",
        "score": "NE 13, PIT 3",
        "text": "Romeo Doubs' 63-yard catch set up Borregales' second field goal, a 45-yarder with 43 seconds left in the quarter, for a 13–3 lead."
      },
      {
        "label": "4th quarter",
        "score": "Final: NE 20, PIT 3",
        "text": "Christian Barmore strip-sacked Aaron Rodgers and Elijah Ponder returned the fumble 19 yards for a touchdown with 13:37 left. With Pittsburgh at the New England 17 and under five minutes to go, rookie linebacker Gabe Jacas intercepted a bobbled short pass meant for Germie Bernard."
      }
    ],
