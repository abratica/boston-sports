    "sections": [
      {
        "label": "1st quarter",
        "score": "NE 14, LV 7",
        "text": "Drake Maye's 35-yard touchdown pass to DeMario Douglas capped a five-play, 79-yard drive (7–0 with 11:23 left). Kirk Cousins answered with a 13-yard touchdown pass to Brock Bowers after a pass interference penalty on Kevin Byard, and Rhamondre Stevenson's 5-yard run put New England back up 14–7 with 1:30 left."
      },
      {
        "label": "2nd quarter",
        "score": "NE 21, LV 7",
        "text": "Maye's 11-yard touchdown pass to Hunter Henry with 24 seconds left in the half made it 21–7 at the break."
      },
      {
        "label": "3rd quarter",
        "score": "NE 35, LV 10",
        "text": "Maye's 34-yard touchdown pass to Kyle Williams made it 28–7 early in the half. Matt Gay's 46-yard field goal got Las Vegas on the board again, and Maye's 3-yard touchdown run made it 35–10 with 3:10 left in the quarter."
      },
      {
        "label": "4th quarter",
        "score": "Final: NE 45, LV 17",
        "text": "Andy Borregales' 28-yard field goal and Dylan Laube's 2-yard touchdown run made it 38–17, and Maye's 8-yard touchdown pass to Douglas, his second of the day, finished the scoring with 6:06 left. Fernando Mendoza replaced Cousins late."
      }
    ],
